# انسخ الملف ده وسمّيه .env واملأ القيم الحقيقية
# لا تشارك ملف .env مع حد ولا ترفعه على GitHub

# رابط الاتصال بقاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# نص سري عشوائي وطويل لتشفير جلسات تسجيل الدخول (غيّره لأي نص عشوائي)
AUTH_SECRET=change-this-to-a-long-random-secret-string

# بيانات دخول لوحة التحكم (لازم تتحدد هنا، مش هتتحط في الكود)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
